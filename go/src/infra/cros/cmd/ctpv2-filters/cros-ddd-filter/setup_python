set -ex

sudo apt install python3.12-venv

python3 -m venv local/ddd-venv
source local/ddd-venv/bin/activate

pip install -r scripts/requirements.frozen

if ! [ -f scripts/chromiumos_root.py ]; then
    read -p 'Please provide your chromiumos root path: ' chromiumos_path

    echo """\
# Copyright 2025 The Chromium Authors
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.
\"\"\"Provides the chromiumos root of the specific user\"\"\"

CHROMIUMOS_ROOT = \"$chromiumos_path\"
""" > scripts/chromiumos_root.py

    echo "Wrote $chromiumos_path to scripts/chromiumos_root.py"
fi

python3 scripts/gen_dlm_devices.py
python3 scripts/gen_build_metadata.py
python3 scripts/generate_enums.py