# found in the LICENSE file.
set -ex

echo dependencies used
echo "   protobuf:" $(which protobuf)
echo "   protoc:" $(which protoc)
echo "   protoc-gen-go:" $(which protoc-gen-go)
echo "   protolint:" $(which protolint)

# format protofiles
protolint -config_path=config/protolint.yaml --fix protos/
echo "The protobuffer definitions have been formated"

mapfile -t proto_files < <(find protos/ -type f -name '*.proto')

protoc \
    --proto_path= "${proto_files[@]}" \
    --go_opt=module=go.chromium.org/infra/cros/cmd/ctpv2-filters/cros-ddd-filter/protos \
    --go_out=protos \
    --python_out=. \
    --pyi_out=. ;