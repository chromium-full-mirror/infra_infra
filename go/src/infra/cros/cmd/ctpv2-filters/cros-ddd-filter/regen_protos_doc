# found in the LICENSE file.
set -ex

# Constants
SYNTAX_PROTO="protos/ttcp/syntax/syntax.proto"
SYNTAX_DESCRIPTOR="local/syntax-descriptor-set.proto.bin"
DESCRIPTOR_PROTO="local/protobuf/descriptor.proto"
DESCRIPTOR_DESCRIPTOR="local/descriptor-descriptor-set.proto.bin"

# We require the descriptor-set.proto.bin of specified protos.
protoc "${SYNTAX_PROTO}" \
    --descriptor_set_out="${SYNTAX_DESCRIPTOR}" ;
protoc "${DESCRIPTOR_PROTO}" \
    --descriptor_set_out="${DESCRIPTOR_DESCRIPTOR}" ;

go build -o protos_doc_gen_bin ttcp/protos_doc_gen/protos_doc_gen.go
./protos_doc_gen_bin \
    docs/protos/ttcp_syntax_doc.md \
    docs/protos/ttcp_syntax.png \
    /bin/dot \
    "${SYNTAX_PROTO}" \
    "${DESCRIPTOR_DESCRIPTOR}" \
    "${SYNTAX_DESCRIPTOR}" ;

rm -f protos_doc_gen_bin
