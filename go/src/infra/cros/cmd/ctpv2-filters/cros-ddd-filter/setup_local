set -ex

# Initialize local folder and symbolic links
if ! [ -d local ]; then
    mkdir local
fi
if ! [ -d local/cros-ddd ]; then
    ln -s ../../../container_uprev/internal/resources/cros-ddd/ local/cros-ddd
fi

# Prepare the local python environment
./setup_python

# Run local env preparer script
go build -o preparelocal devscripts/main.go
if [ -d local/chromeos-hwid ]; then
    rm -rf local/chromeos-hwid
fi
./preparelocal
rm -f preparelocal

# Unzip artifacts of preparer script into local environments
rm -f datasets/generated/*
rm -f docs/datasets/*
unzip local/named_ttcp_classes_and_categories_dataset.zip -d datasets/generated
unzip local/named_ttcp_classes_and_categories_docs.zip -d docs/datasets

# Load descriptor protobuf from archive
if [ -d protobuf ]; then
    rm -rf protobuf/
fi
wget -O protobufarchive.tar.gz https://github.com/protocolbuffers/protobuf/archive/v21.5.tar.gz
tar -xvzf protobufarchive.tar.gz -C local/ --wildcards --no-wildcards-match-slash --transform="s/.*\//protobuf\//" "protobuf*/src/google/protobuf/descriptor.proto"
rm -f protobufarchive.tar.gz

# Regenerate the protos doc
./regen_protos_doc
