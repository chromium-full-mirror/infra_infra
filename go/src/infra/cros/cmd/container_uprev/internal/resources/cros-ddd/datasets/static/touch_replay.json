{
    "name": "Touch Replay Suites 3D Expressions",
    "description": "Categories defined for touch replay test suites",
    "owners": [
        "crosep-intertech@google.com"
    ],
    "classes": {
        "touchscreen:soc:not_empty": {
            "name": "touchscreen:soc:not_empty",
            "description": "Class matches the targets that have a touchscreen.",
            "expression": {
                "not": {
                    "sub_expression": {
                        "property": {
                            "propertyPath": "touchscreen_field",
                            "strEqual": ""
                        }
                    }
                }
            }
        },
        "stylus:soc:not_empty": {
            "name": "stylus:soc:not_empty",
            "description": "Class matches the targets that have a stylus.",
            "expression": {
                "not": {
                    "sub_expression": {
                        "property": {
                            "propertyPath": "stylus_field",
                            "strEqual": ""
                        }
                    }
                }
            }
        },
        "touchpad:soc:not_empty": {
            "name": "touchpad:soc:not_empty",
            "description": "Class matches the targets that have a touchpad.",
            "expression": {
                "not": {
                    "sub_expression": {
                        "property": {
                            "propertyPath": "touchpad_field",
                            "strEqual": ""
                        }
                    }
                }
            }
        }
    },
    "categories": {
        "Touchscreen:Not_Empty": {
            "name": "Touchscreen:Not_Empty",
            "description": "Category with a single class that matches the contexts not with touchscreen equals empty.",
            "enumerated": {
                "classes": [
                    {
                        "name": "touchscreen:soc:not_empty"
                    }
                ]
            }
        },
        "Stylus:Not_Empty": {
